# Hand-off to Ansible: write the inventory that infra/ansible/site.yml uses.
resource "local_file" "ansible_inventory" {
  filename             = "${path.module}/../ansible/inventory/hosts.ini"
  file_permission      = "0644"
  directory_permission = "0755"
  content              = <<-EOT
    # Generated by Terraform (infra/terraform/inventory.tf). Re-run `terraform apply` instead of editing.
    [k3s]
    skybook ansible_host=${oci_core_instance.skybook.public_ip} ansible_user=ubuntu
  EOT
}
