# SkyBook frontend: static site + reverse proxy for the two APIs.
#
# This is a template. At container start the image's entrypoint
# (/docker-entrypoint.d/20-envsubst-on-templates.sh) renders it to
# /etc/nginx/conf.d/default.conf, filling in the dollar-brace placeholders from
# environment variables. Only variables that are set get substituted, which is
# why nginx's own lowercase $variables survive untouched. The Dockerfile gives
# every placeholder used here a default.
#
# The file is included inside the http {} block of the image's nginx.conf,
# which already puts the pid file and all temp paths under /tmp; together with
# an emptyDir on /etc/nginx/conf.d that allows readOnlyRootFilesystem.

# Reuse the caller's X-Request-ID if there is one, otherwise mint one, and pass
# it upstream so a single id ties together the logs of every service.
map $http_x_request_id $skybook_request_id {
  default $http_x_request_id;
  ""      $request_id;
}

# JSON access log. $uri (not $request_uri) so query strings, which may carry an
# email address, stay out of the logs.
log_format skybook_json escape=json
  '{"time":"$time_iso8601","level":"info","service":"frontend",'
  '"msg":"request completed","request_id":"$skybook_request_id",'
  '"remote_addr":"$remote_addr","method":"$request_method","path":"$uri",'
  '"status":$status,"bytes":$body_bytes_sent,"duration_s":$request_time,'
  '"upstream":"$upstream_addr","upstream_duration_s":"$upstream_response_time",'
  '"user_agent":"$http_user_agent"}';

server {
  listen 8080;
  server_name _;

  root /usr/share/nginx/html;
  index index.html;
  charset utf-8;
  charset_types text/css text/plain text/javascript application/javascript application/json image/svg+xml;

  access_log /var/log/nginx/access.log skybook_json;
  server_tokens off;
  # Relative redirects: behind an ingress, an absolute redirect would leak the
  # container's port (8080) and scheme.
  absolute_redirect off;
  client_max_body_size 16k;

  gzip on;
  gzip_vary on;
  gzip_proxied any;
  gzip_comp_level 5;
  gzip_min_length 512;
  gzip_types text/css text/javascript application/javascript application/json image/svg+xml text/plain;

  # Security headers. "always" also adds them to error responses. Locations
  # below must not use add_header themselves, or they would stop inheriting
  # these (nginx's all-or-nothing add_header inheritance).
  add_header X-Content-Type-Options "nosniff" always;
  add_header X-Frame-Options "DENY" always;
  add_header Referrer-Policy "strict-origin-when-cross-origin" always;
  add_header Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()" always;
  add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'" always;

  # Shared by both API locations.
  proxy_http_version 1.1;
  proxy_set_header Connection "";
  proxy_set_header Host $host;
  proxy_set_header X-Real-IP $remote_addr;
  proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
  proxy_set_header X-Forwarded-Proto $scheme;
  proxy_set_header X-Request-ID $skybook_request_id;
  proxy_connect_timeout 5s;
  proxy_send_timeout 30s;
  proxy_read_timeout 30s;

  location = /healthz {
    access_log off;
    default_type text/plain;
    return 200 "ok\n";
  }

  location = /version.json {
    default_type application/json;
    expires epoch;
    return 200 '{"service":"frontend","version":"${APP_VERSION}","environment":"${APP_ENV}"}';
  }

  # No URI part after the host in proxy_pass, so the original path
  # (/api/flights/...) is passed through unchanged. ^~ stops the static-asset
  # regex below from ever claiming an API path.
  location ^~ /api/flights/ {
    proxy_pass ${FLIGHT_SEARCH_URL};
    error_page 502 504 = @api_unavailable;
  }

  location ^~ /api/bookings {
    proxy_pass ${BOOKING_API_URL};
    error_page 502 504 = @api_unavailable;
  }

  # nginx could not reach the upstream (502) or it timed out (504). Answer in
  # the same JSON shape the APIs use instead of nginx's HTML error page.
  location @api_unavailable {
    default_type application/json;
    return 503 '{"error":"Service temporarily unavailable","detail":"Service temporarily unavailable"}';
  }

  # index.html must always be revalidated so a new release is picked up
  # immediately; "expires epoch" sends Cache-Control: no-cache.
  location = /index.html {
    expires epoch;
  }

  # Static assets have unversioned names, so cache briefly and revalidate.
  location ~* \.(?:css|js|svg|ico|png|webp|woff2?)$ {
    expires 5m;
    access_log off;
  }

  # Unknown paths fall back to the app shell.
  location / {
    try_files $uri $uri/ /index.html;
  }
}
